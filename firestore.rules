rules_version = '2';
// Rosita Personal · reglas de seguridad de Firestore
// Cada persona inicia sesión con su PIN (Firebase Auth). Su rol vive en /uids/{authUid}.
service cloud.firestore {
  match /databases/{db}/documents {

    function signed()    { return request.auth != null; }
    function uidDoc()    { return /databases/$(db)/documents/uids/$(request.auth.uid); }
    function hasMe()     { return signed() && exists(uidDoc()); }
    function me()        { return get(uidDoc()).data; }
    function role()      { return me().role; }
    function isAdmin()   { return hasMe() && role() == 'admin'; }
    function canUsers()  { return hasMe() && role() in ['admin', 'sistemas']; }
    function isMgr()     { return hasMe() && role() in ['admin', 'jefe']; }
    function canPost()   { return hasMe() && role() in ['admin', 'jefe', 'encargada', 'fundador', 'sistemas']; }
    function setupDone() { return exists(/databases/$(db)/documents/meta/setup); }
    // Solo durante la configuración inicial (antes de que exista meta/setup)
    function firstRun()  { return signed() && !setupDone(); }
    function staffRole(sid) { return get(/databases/$(db)/documents/staff/$(sid)).data.role; }
    function staffDept(sid) { return get(/databases/$(db)/documents/staff/$(sid)).data.dept; }
    function canGrant(sid) {
      return hasMe() && sid != me().sid && (isAdmin()
        || (role() == 'jefe' && staffDept(sid) == me().dept && !(staffRole(sid) in ['jefe', 'admin', 'fundador'])));
    }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /meta/setup {
      allow read: if true;
      allow create: if firstRun()
        && getAfter(uidDoc()).data.role == 'admin';
    }

    // Directorio público para la pantalla de ingreso (nombre, puesto, tienda, foto)
    match /directory/{sid} {
      allow read: if true;
      allow write: if canUsers() || firstRun()
        || (hasMe() && me().sid == sid && onlyKeys(['photo']));
    }

    match /staff/{sid} {
      allow read: if hasMe();
      allow write: if canUsers() || firstRun();
    }

    match /uids/{uid} {
      allow read: if signed() && (request.auth.uid == uid || canUsers());
      allow write: if canUsers() || (firstRun() && request.auth.uid == uid);
    }

    match /stores/{id} {
      allow read: if true;
      allow write: if isAdmin() || firstRun();
    }

    match /horarios/{id} {
      allow read: if hasMe();
      allow write: if isAdmin() || firstRun();
    }

    // Marcas: cada quien crea las suyas; gerencia, jefes y encargadas pueden leerlas
    match /marks/{id} {
      allow read: if hasMe() && (resource.data.sid == me().sid
        || role() in ['admin', 'jefe', 'fundador', 'encargada']);
      allow create: if hasMe() && request.resource.data.sid == me().sid;
      allow update, delete: if isAdmin();
    }

    // Resumen del día: cada quien solo puede tocar su propia entrada en los mapas
    match /days/{day} {
      allow read: if hasMe();
      allow create: if hasMe();
      allow update: if hasMe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arr', 'out', 'lunch'])
        && request.resource.data.get('arr', {}).diff(resource.data.get('arr', {})).affectedKeys().hasOnly([me().sid])
        && request.resource.data.get('out', {}).diff(resource.data.get('out', {})).affectedKeys().hasOnly([me().sid])
        && request.resource.data.get('lunch', {}).diff(resource.data.get('lunch', {})).affectedKeys().hasOnly([me().sid]);
    }

    // Cambios de día de descanso
    match /cambios/{id} {
      allow read: if hasMe();
      // Nadie se aprueba a sí mismo; un jefe solo decide sobre gente de su área que no sea jefe.
      allow create: if hasMe() && (request.resource.data.sid == me().sid || isMgr() || role() == 'encargada')
        && (request.resource.data.estado == 'pendiente' || canGrant(request.resource.data.sid));
      allow update: if canGrant(resource.data.sid) && request.resource.data.decidedBy == me().sid;
      allow delete: if isAdmin();
    }

    // Muro: publicaciones de texto, anuncios, reconocimientos y fotos
    match /posts/{id} {
      allow read: if hasMe();
      allow create: if canPost() && request.resource.data.by == me().sid
        && request.resource.data.kind in ['anuncio', 'reco', 'foto', 'texto'];
      // Cualquiera reacciona, comenta (contador y último comentario) y marca "visto" solo con su propio nombre
      allow update: if hasMe() && onlyKeys(['likedBy', 'claps', 'seen', 'nc', 'lastC'])
        && request.resource.data.get('seen', {}).diff(resource.data.get('seen', {})).affectedKeys().hasOnly([me().sid])
        && request.resource.data.get('nc', 0) - resource.data.get('nc', 0) in [-1, 0, 1];
      allow delete: if isAdmin() || (hasMe() && resource.data.by == me().sid);

      // Comentarios: todo el equipo comenta (también las asesoras); cada quien borra los suyos
      match /comments/{cid} {
        allow read: if hasMe();
        allow create: if hasMe() && request.resource.data.by == me().sid
          && request.resource.data.tx is string && request.resource.data.tx.size() > 0 && request.resource.data.tx.size() <= 500;
        allow delete: if isAdmin() || (hasMe() && resource.data.by == me().sid);
      }
    }

    // Notificaciones de la campanita: cada quien solo ve las suyas y solo puede marcarlas como leídas
    match /avisos/{id} {
      allow read: if hasMe() && resource.data.to == me().sid;
      allow create: if hasMe() && request.resource.data.from == me().sid && request.resource.data.to != me().sid
        && request.resource.data.keys().hasOnly(['to', 'from', 'type', 'post', 'c', 'tx', 'at', 'read', 'sent'])
        && request.resource.data.type in ['comment', 'reply', 'mention', 'reco', 'rx']
        && request.resource.data.tx is string && request.resource.data.tx.size() <= 140;
      allow update: if hasMe() && resource.data.to == me().sid && onlyKeys(['read']);
      allow delete: if hasMe() && resource.data.to == me().sid;
    }

    // Datos privados de cada persona (celulares registrados para recibir avisos)
    match /privado/{sid} {
      allow read, write: if hasMe() && me().sid == sid;
    }

    // Estado del envío de avisos (lo maneja solo el servidor)
    match /meta/push {
      allow read, write: if false;
    }

    // Resultados de la Arena D'La Rossa (sin quetzales): los escribe solo el puente automático de la Arena
    match /arena/{id} {
      allow read: if hasMe();
      allow write: if false;
    }

    // Notas tipo Instagram (una por persona, duran 24 h)
    match /notes/{sid} {
      allow read: if hasMe();
      allow write: if hasMe() && me().sid == sid;
      // Cualquiera puede reaccionar a una nota: solo toca su propia reacción
      allow update: if hasMe() && onlyKeys(['rx'])
        && request.resource.data.get('rx', {}).diff(resource.data.get('rx', {})).affectedKeys().hasOnly([me().sid]);
      allow delete: if hasMe() && (me().sid == sid || isMgr());
    }

    // ---------- Mando Gerentes (tableros por área) ----------
    // Datos de cada área: los escribe solo el proceso automático de la Arena (llave de servicio).
    // Los lee Gerencia o quien Gerencia anotó en mandoAcceso/{area}.
    function accesoArea(area) {
      return hasMe() && (isAdmin()
        || (exists(/databases/$(db)/documents/mandoAcceso/$(area))
            && me().sid in get(/databases/$(db)/documents/mandoAcceso/$(area)).data.get('sids', [])));
    }
    match /mando/{area} {
      allow read: if accesoArea(area);
      allow write: if false;
      match /datos/{pieza} {
        allow read: if accesoArea(area);
        allow write: if false;
      }
    }
    // Quién ve cada área: solo Gerencia lo cambia; cada quien puede revisar a qué áreas tiene acceso.
    match /mandoAcceso/{area} {
      allow read: if hasMe();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['sids', 'por', 'en'])
        && request.resource.data.sids is list && request.resource.data.sids.size() <= 60;
    }
  }
}
